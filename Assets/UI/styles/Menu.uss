:root {
}

.menu {
    flex-grow: 1;
    flex-direction: column;
    position: absolute;
    top: 0px;
    left: 0px;
    bottom: 0px;
    right: 0px;
    padding: 0px;
    align-items: center;
    justify-content: flex-start;
}

.menu__topbar {
    border-color: var(--bone-white);
    border-bottom-width: 2px;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 10%;
    flex-grow: 0;
    padding: 10px;
    background-color: var(--dark-background)
}

.menu__navigation {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    max-width: 1000px;
    height: 80%;
    flex-grow: 0;
    width: 100%;
}

.menu__topbar__button {
    flex-grow: 1;
    background-color: var(--light-black);
    border-color: var(--bone-white);
    border-width: 1px;
    transition-property: scale;
    transition-duration: 100ms;
    height: 80%;
    flex-shrink: 0;
    flex-grow: 1;
    max-width: 180px;
}

.menu__topbar__button:hover {
    background-color: rgb(90, 142, 227);
    scale: 1.1;
}

.menu__topbar__button--2 {
    height: 60%;
    max-width: 150px;
}

.menu__topbar__label {
    background-color: rgb(66, 109, 180);
    transition-property: scale;
    transition-duration: 100ms;
    height: 100%;
    flex-grow: 2;
    max-width: 200px;
    -unity-text-align: middle-center;
}

.menu__topbar__label:hover {
    background-color: rgb(90, 142, 227);
    scale: 1.1;
}

.menu__templateholder {
    flex-grow: 1;
    width: 100%;
    align-self: stretch;
}
