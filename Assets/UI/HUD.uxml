<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="HUD" style="flex-grow: 1; border-right-width: 0; top: auto; bottom: 1%; left: 35%; right: 40%; width: 30%; height: auto; aspect-ratio: 2.5; position: absolute; border-top-width: 0; border-bottom-width: 0; border-left-width: 0;">
        <ui:VisualElement name="temperatureDisplay" style="flex-grow: 1; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; height: 70%; bottom: auto; width: 30%; left: auto; aspect-ratio: 1; align-self: center; position: absolute; top: 25%;">
            <ui:VisualElement name="temperatureFill" style="flex-grow: 1; position: absolute; height: 100%; width: auto; left: auto; align-self: center; align-content: center; justify-content: flex-start; top: auto; visibility: visible; -unity-background-image-tint-color: rgb(0, 0, 0); background-color: rgb(190, 40, 40); bottom: auto; overflow: hidden; border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px; align-items: center; aspect-ratio: 1; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
                <ui:Label text="Label" name="temperatureLabel" style="position: absolute; left: 0%; bottom: 0%; width: auto; height: 20%; align-self: center; top: 40%; justify-content: flex-start; -unity-text-align: middle-center; font-size: 20%; aspect-ratio: 2; -unity-font-definition: url(&quot;project://database/Assets/SairaStencil-Light.otf?fileID=12800000&amp;guid=d2db5b6ac60ad7343bf942d60836035a&amp;type=3#SairaStencil-Light&quot;); color: rgb(255, 255, 255); align-content: flex-start; align-items: auto; text-overflow: clip; white-space: normal; -unity-font-style: normal; -unity-text-auto-size: none; -unity-text-generator: standard; right: 0%; text-shadow: 0 0 0 rgba(0, 0, 0, 0); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="foodDisplay" style="flex-grow: 1; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; height: 35%; bottom: auto; width: auto; left: 20%; aspect-ratio: 1; align-self: center; position: absolute; top: 20%;">
            <ui:VisualElement name="foodFill" style="flex-grow: 1; position: absolute; height: 100%; width: auto; left: auto; align-self: center; align-content: center; justify-content: flex-start; top: auto; visibility: visible; -unity-background-image-tint-color: rgb(0, 0, 0); background-color: rgba(0, 0, 0, 0.5); bottom: auto; overflow: hidden; border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px; align-items: auto; aspect-ratio: 1;">
                <ui:Label text="Label" name="foodBarLabel" style="position: absolute; left: 0%; bottom: 0%; width: auto; height: 20%; align-self: center; top: 40%; justify-content: flex-start; -unity-text-align: middle-center; font-size: 15%; aspect-ratio: 2; -unity-font-definition: url(&quot;project://database/Assets/SairaStencil-Light.otf?fileID=12800000&amp;guid=d2db5b6ac60ad7343bf942d60836035a&amp;type=3#SairaStencil-Light&quot;); color: rgb(255, 255, 255); align-content: flex-start; align-items: auto; text-overflow: clip; white-space: normal; -unity-font-style: normal; -unity-text-auto-size: none; -unity-text-generator: standard; right: 0%; text-shadow: 0 0 0 rgba(0, 0, 0, 0); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            </ui:VisualElement>
            <CircularBarProgression name="circularFoodBar" style="position: absolute; width: 100%; height: 100%; border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="heathBarDisplay" style="flex-grow: 1; left: auto; top: 70%; height: 25%; bottom: auto; align-self: stretch; position: absolute; width: 100%; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
            <ui:VisualElement name="healthBarBackground" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); background-color: rgb(149, 201, 161); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px;"/>
            <ui:VisualElement name="healthBarDelay" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>
            <ui:VisualElement name="healthBarFill" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; -unity-material: url(&quot;&quot;); background-color: rgb(32, 140, 64); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>
            <ui:Label text="Label" name="healthBarLabel" style="position: absolute; left: auto; bottom: auto; width: 86px; height: 80%; align-self: center; top: 10%; justify-content: flex-start; -unity-text-align: middle-right; font-size: 20%; aspect-ratio: 1; -unity-font-definition: url(&quot;project://database/Assets/SairaStencil-Light.otf?fileID=12800000&amp;guid=d2db5b6ac60ad7343bf942d60836035a&amp;type=3#SairaStencil-Light&quot;); color: rgb(255, 255, 255); align-content: flex-start; align-items: auto; text-overflow: clip; white-space: normal; -unity-font-style: normal; -unity-text-auto-size: none; -unity-text-generator: standard; right: 2%; text-shadow: 0 0 0 rgba(0, 0, 0, 0); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement name="thirstDisplay" style="flex-grow: 1; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; height: 35%; bottom: auto; width: auto; left: auto; aspect-ratio: 1; align-self: center; position: absolute; top: 20%; right: 20%;">
            <ui:VisualElement name="thirstFill" style="flex-grow: 1; position: absolute; height: 100%; width: auto; left: auto; align-self: center; align-content: center; justify-content: flex-start; top: auto; visibility: visible; -unity-background-image-tint-color: rgb(0, 0, 0); background-color: rgba(0, 0, 0, 0.5); bottom: auto; overflow: hidden; border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px; align-items: auto; aspect-ratio: 1;">
                <ui:Label text="Label" name="thirstBarLabel" style="position: absolute; left: 0%; bottom: 0%; width: auto; height: 20%; align-self: center; top: 40%; justify-content: flex-start; -unity-text-align: middle-center; font-size: 15%; aspect-ratio: 2; -unity-font-definition: url(&quot;project://database/Assets/SairaStencil-Light.otf?fileID=12800000&amp;guid=d2db5b6ac60ad7343bf942d60836035a&amp;type=3#SairaStencil-Light&quot;); color: rgb(255, 255, 255); align-content: flex-start; align-items: auto; text-overflow: clip; white-space: normal; -unity-font-style: normal; -unity-text-auto-size: none; -unity-text-generator: standard; right: 0%; text-shadow: 0 0 0 rgba(0, 0, 0, 0); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            </ui:VisualElement>
            <CircularBarProgression name="circularThirstBar" style="position: absolute; width: 100%; height: 100%; border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
