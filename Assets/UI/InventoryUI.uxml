<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="MenuBackground" style="flex-grow: 1; top: 5%; left: 5%; bottom: 5%; right: 5%; position: absolute; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; background-color: rgba(0, 0, 0, 0.5); border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px; align-items: stretch;">
        <ui:VisualElement name="MenuInventory" style="flex-grow: 1; top: 20%; position: absolute; height: 75%; width: 90%; align-items: stretch; justify-content: center; left: 5%; bottom: 5%; right: 5%; align-self: auto;">
            <ui:VisualElement name="MenuInventoryEquipement" style="flex-grow: 1; width: 20%; height: 100%; align-self: flex-start; position: absolute; bottom: auto;"/>
            <ui:VisualElement name="MenuInventoryObjectDescription" style="flex-grow: 1; width: 20%; height: 100%; align-self: flex-end; position: absolute; bottom: auto;"/>
            <ui:ProgressBar value="22" title="Weight" name="WeightBar" style="position: absolute; height: 3%; width: 50%; left: 25%; bottom: 5%;"/>
            <ui:VisualElement name="MenuInventoryInventory" style="flex-grow: 1; width: 50%; height: 90%; align-self: center; position: absolute; bottom: 10%; -unity-slice-type: sliced; -unity-background-image-tint-color: rgb(255, 255, 255); background-repeat: round round; background-image: url(&quot;project://database/Assets/UI/Inventory%20shema%20V1.png?fileID=2800000&amp;guid=90d6a4839d655c24d8413c6972c90362&amp;type=3#Inventory shema V1&quot;); top: 0%; left: 25%; right: 25%; background-size: 15% 15%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="MenuTopBar" style="flex-grow: 1; position: absolute; top: 5%; right: auto; bottom: auto; width: 60%; height: 10%; left: auto; align-self: center; align-content: flex-start; align-items: stretch; justify-content: center;">
            <ui:Button text="R" name="MenuRightButton" tabindex="0" triple-click-selects-line="false" style="position: absolute; top: auto; left: auto; bottom: auto; right: 20%; width: 15%; height: 65%; aspect-ratio: auto; -unity-text-align: middle-center; align-self: flex-end; align-content: flex-start; justify-content: flex-start; align-items: flex-end; background-color: rgb(66, 109, 180);"/>
            <ui:Button text="L" name="MenuLeftButton" tabindex="0" triple-click-selects-line="false" style="position: absolute; top: auto; left: 20%; bottom: auto; right: auto; width: 15%; height: 65%; aspect-ratio: auto; -unity-text-align: middle-center; align-self: flex-start; align-items: flex-start; background-color: rgb(66, 109, 180);"/>
            <ui:Button text="2R" name="Menu2RightButton" tabindex="0" triple-click-selects-line="false" parse-escape-sequences="true" style="position: absolute; top: auto; left: auto; bottom: auto; right: auto; width: 15%; height: 55%; aspect-ratio: auto; -unity-text-align: middle-center; align-self: flex-end; align-content: flex-start; justify-content: flex-start; align-items: flex-end; background-color: rgb(104, 141, 202);"/>
            <ui:Button text="2L" name="Menu2LeftButton" tabindex="0" triple-click-selects-line="false" style="position: absolute; top: auto; left: auto; bottom: auto; right: auto; width: 15%; height: 55%; aspect-ratio: auto; -unity-text-align: middle-center; align-self: flex-start; align-items: flex-start; background-color: rgb(104, 141, 202);"/>
            <ui:Label text="Inventory" name="MenuCentralLabel" style="align-self: center; width: 20%; height: 100%; font-size: 50px; -unity-font-definition: url(&quot;project://database/Assets/SairaStencil-Light.otf?fileID=12800000&amp;guid=d2db5b6ac60ad7343bf942d60836035a&amp;type=3#SairaStencil-Light&quot;); text-overflow: ellipsis; -unity-text-align: middle-center; -unity-font-style: normal; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(47, 125, 168); border-right-color: rgb(47, 125, 168); border-top-color: rgb(47, 125, 168); border-bottom-color: rgb(47, 125, 168); background-color: rgb(43, 83, 149); -unity-background-image-tint-color: rgb(255, 255, 255); background-size: 100% 100%; -unity-background-scale-mode: stretch-to-fill; background-position-x: center; background-position-y: center; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(255, 233, 227);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
