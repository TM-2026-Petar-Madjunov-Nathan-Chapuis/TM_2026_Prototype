.inventory {
    flex-grow: 1;
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
}

.inventory__equipement {
    background-color: #0d00ff;
    flex-shrink: 0;
    width: 25%;
}

.inventory__item-description {
    background-color: #00ff0d;
    flex-shrink: 0;
    width: 25%;
}

.inventory__items-list {
    flex-grow: 1;
}

.inventory__weight-bar {
    flex-grow: 0;
    height: 40px;
}
.inventory__main {
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
}
.inventory__items-label {
    -unity-text-align: middle-center;
}