<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/styles/PauseMenuStyles.uss?fileID=7433441132597879392&amp;guid=15a7d94582a302b4bb8d3ddfc62b2494&amp;type=3#PauseMenuStyles"/>
    <ui:VisualElement name="MenuBackground" picking-mode="Ignore" class="PauseMenuBorder" style="flex-grow: 1; align-items: center; align-self: center; width: 25%; height: auto; aspect-ratio: 0.6; position: absolute; top: auto; display: none; visibility: visible; max-width: none; max-height: none; justify-content: flex-start; min-width: auto; min-height: auto; background-color: rgba(0, 0, 0, 0.75); left: 5%; border-right-color: rgb(66, 109, 180); border-left-color: rgb(66, 109, 180); border-right-width: initial; border-left-width: initial; border-top-color: rgb(66, 109, 180); border-bottom-color: rgb(66, 109, 180); border-bottom-width: initial; border-top-width: initial; align-content: auto; translate: 0% 0%; transition-property: translate; transition-duration: 0.5s; transition-timing-function: ease-in-out; bottom: 0%;">
        <ui:Button text="♦   NEW GAME   ♦" name="NewGameButton" emoji-fallback-support="true" class="PauseMenuButtonsUSS unity-buttonMM" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; justify-content: center;"/>
        <ui:Button text="LOAD GAME" name="LoadGameButton" emoji-fallback-support="true" class="PauseMenuButtonsUSS unity-buttonMM" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
        <ui:Button text="SETTINGS" name="SettingsButton" emoji-fallback-support="true" class="PauseMenuButtonsUSS unity-buttonMM" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
        <ui:Button text="CREDITS" name="CreditsButton" emoji-fallback-support="true" class="PauseMenuButtonsUSS unity-buttonMM" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
        <ui:Button text="QUIT GAME" name="QuitGameButton" emoji-fallback-support="true" class="PauseMenuButtonsUSS unity-buttonMM" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 1; width: 60%; aspect-ratio: 3; background-image: resource(&quot;UI/UIdecoration1&quot;); bottom: 2.5%; height: auto; position: absolute; align-self: center;"/>
    </ui:VisualElement>
    <ui:VisualElement name="SettingsMenu" picking-mode="Ignore" class="MMmenues" style="flex-grow: 1; position: absolute; align-self: center; background-color: rgba(0, 0, 0, 0.5); visibility: visible; display: none; justify-content: space-between;">
        <ui:VisualElement name="TopRow" style="flex-grow: 0; justify-content: space-between; align-items: flex-start; align-content: auto; flex-direction: row; align-self: auto; padding-top: 20px; padding-right: 20px; padding-left: 20px; background-size: 100% 100%; width: 100%; position: relative; aspect-ratio: auto;">
            <ui:Button text="←" name="BackFromSettingsToPause" class="BackToMMButtons"/>
            <ui:Label text="Settings" name="Label" double-click-selects-word="false" style="color: rgb(255, 255, 255); font-size: 32%; -unity-text-align: upper-center; top: auto; position: relative; align-self: auto; height: 37px; align-items: auto; align-content: auto; justify-content: center; flex-direction: column; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; -unity-font-definition: resource(&quot;Font/Barlow_Condensed/BarlowCondensed-SemiBold&quot;);"/>
            <ui:VisualElement style="flex-grow: 0; flex-shrink: 1; width: 10%; aspect-ratio: 1;"/>
        </ui:VisualElement>
        <ui:Label text="Settings (NOT COMING SOON)" name="Label" style="color: rgb(255, 255, 255); font-size: 20%; -unity-text-align: upper-center; top: auto; position: relative; align-self: center;"/>
    </ui:VisualElement>
    <ui:VisualElement name="LoadSaveMenu" picking-mode="Ignore" enabled="true" class="MMmenues" style="flex-grow: 1; position: absolute; align-self: center; background-color: rgba(0, 0, 0, 0.5); visibility: visible; display: flex; height: auto; width: 40%;">
        <ui:VisualElement name="TopRow" style="flex-grow: 0; justify-content: space-between; align-items: flex-start; align-content: auto; flex-direction: row; align-self: auto; padding-top: 20px; padding-right: 20px; padding-left: 20px; background-size: 100% 100%; width: 100%; position: relative; aspect-ratio: auto;">
            <ui:Button name="BackFromLoadingToPause" text="←" class="BackToMMButtons"/>
            <ui:Label text="Load a save file" name="Label" double-click-selects-word="false" style="color: rgb(255, 255, 255); font-size: 32%; -unity-text-align: upper-center; top: auto; position: relative; align-self: auto; height: 37px; align-items: auto; align-content: auto; justify-content: center; flex-direction: column; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; -unity-font-definition: resource(&quot;Font/Barlow_Condensed/BarlowCondensed-SemiBold&quot;);"/>
            <ui:VisualElement style="flex-grow: 0; flex-shrink: 1; width: 10%; aspect-ratio: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="BottomRow" style="flex-grow: 1; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;">
            <ui:VisualElement name="FileSelection" class="PauseMenuBorder" style="flex-grow: 1; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;">
