<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="HUD" style="flex-grow: 1; border-right-width: 3px; top: auto; bottom: 1%; left: 35%; right: 40%; width: 30%; height: auto; aspect-ratio: 2.5; position: absolute; border-top-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgb(0, 0, 255); border-right-color: rgb(0, 0, 255); border-top-color: rgb(0, 0, 255); border-bottom-color: rgb(0, 0, 255);">
        <ui:VisualElement name="temperatureDisplay" style="flex-grow: 1; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; height: 55%; bottom: auto; width: 20%; left: auto; aspect-ratio: 1; align-self: center; position: absolute; top: 30%;">
            <ui:VisualElement name="temperatureFill" style="flex-grow: 1; position: absolute; height: 100%; width: auto; left: auto; align-self: center; align-content: center; justify-content: flex-start; top: auto; visibility: visible; -unity-background-image-tint-color: rgb(0, 0, 0); background-color: rgb(190, 40, 40); bottom: auto; overflow: hidden; border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px; align-items: center; aspect-ratio: 1;">
                <ui:Label text="Label" name="temperatureLabel" style="position: absolute; left: auto; bottom: auto; width: 40%; height: 20%; align-self: center; top: 20%; justify-content: flex-start; -unity-text-align: middle-center; font-size: 20%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="foodDisplay" style="flex-grow: 1; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; height: 35%; bottom: auto; width: auto; left: 25%; aspect-ratio: 1; align-self: center; position: absolute; top: 10%;">
            <ui:Label text="Label" name="foodBarLabel" style="position: absolute; left: auto; bottom: auto; width: auto; height: 20%; align-self: center; top: 40%; justify-content: flex-start; -unity-text-align: lower-center; font-size: 10%; aspect-ratio: auto;"/>
            <CircularBarProgression name="circularFoodBar" style="position: absolute; width: 100%; height: 100%; border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="thirstDisplay" style="flex-grow: 1; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; height: 35%; bottom: auto; width: auto; left: auto; aspect-ratio: 1; align-self: center; position: absolute; top: 10%; right: 25%;">
            <ui:VisualElement name="thirstFill" style="flex-grow: 1; position: absolute; height: 100%; width: auto; left: auto; align-self: center; align-content: center; justify-content: flex-start; top: auto; visibility: visible; -unity-background-image-tint-color: rgb(0, 0, 0); background-color: rgb(190, 40, 40); bottom: auto; overflow: hidden; border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px; align-items: center; aspect-ratio: 1;">
                <ui:Label text="Label" name="thirstLabel" style="position: absolute; left: auto; bottom: auto; width: auto; height: 20%; align-self: center; top: 40%; justify-content: flex-start; -unity-text-align: lower-center; font-size: 10%; aspect-ratio: auto;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="heathBarDisplay" style="flex-grow: 1; left: auto; top: 70%; height: 30%; bottom: auto; align-self: stretch; position: absolute; width: 100%;">
            <ui:VisualElement name="healthBarBackground" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; border-left-color: rgb(102, 255, 132); border-right-color: rgb(102, 255, 132); border-top-color: rgb(102, 255, 132); border-bottom-color: rgb(102, 255, 132); background-color: rgb(176, 255, 172);"/>
            <ui:VisualElement name="healthBarDelay" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;"/>
            <ui:VisualElement name="healthBarFill" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; -unity-material: url(&quot;&quot;); background-color: rgb(0, 164, 21);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
