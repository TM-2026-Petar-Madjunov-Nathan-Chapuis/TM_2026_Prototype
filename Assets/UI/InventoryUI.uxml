<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="MenuBackground" style="flex-grow: 1; top: 5%; left: 5%; bottom: 5%; right: 5%; position: absolute; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; background-color: rgba(25, 115, 213, 0.5); border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px; align-items: stretch;">
        <ui:VisualElement name="MenuInventory" style="flex-grow: 1; top: 20%; position: absolute; height: 75%; width: 90%; align-items: stretch; justify-content: center; left: 5%; bottom: 5%; right: 5%; align-self: auto;">
            <ui:VisualElement name="MenuInventoryEquipement" style="flex-grow: 1; width: 20%; height: 100%; align-self: flex-start; position: absolute; bottom: auto;"/>
            <ui:VisualElement name="MenuInventoryInventory" style="flex-grow: 1; width: 50%; height: 90%; align-self: center; position: absolute; bottom: 10%;"/>
            <ui:VisualElement name="MenuInventoryObjectDescription" style="flex-grow: 1; width: 20%; height: 100%; align-self: flex-end; position: absolute; bottom: auto;"/>
            <ui:ProgressBar value="22" title="my-progress" name="WeightBar" style="position: absolute; height: 3%; width: 50%; left: 25%; bottom: 5%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="MenuTopBar" style="flex-grow: 1; position: absolute; top: 5%; right: auto; bottom: auto; width: 60%; height: 10%; left: auto; align-self: center; align-content: flex-start; align-items: stretch; justify-content: center;">
            <ui:Button text="R" name="MenuRightButton" tabindex="0" triple-click-selects-line="false" style="position: absolute; top: auto; left: auto; bottom: auto; right: 20%; width: 15%; height: 65%; aspect-ratio: auto; -unity-text-align: middle-center; align-self: flex-end; align-content: flex-start; justify-content: flex-start; align-items: flex-end;"/>
            <ui:Image name="MenuCentralImage" tint-color="rgb(255, 255, 255)" style="width: 20%; height: 100%; align-self: center; align-content: flex-start;"/>
            <ui:Button text="L" name="MenuLeftButton" tabindex="0" triple-click-selects-line="false" style="position: absolute; top: auto; left: 20%; bottom: auto; right: auto; width: 15%; height: 65%; aspect-ratio: auto; -unity-text-align: middle-center; align-self: flex-start; align-items: flex-start;"/>
            <ui:Button text="2R" name="Menu2RightButton" tabindex="0" triple-click-selects-line="false" parse-escape-sequences="true" style="position: absolute; top: auto; left: auto; bottom: auto; right: auto; width: 15%; height: 55%; aspect-ratio: auto; -unity-text-align: middle-center; align-self: flex-end; align-content: flex-start; justify-content: flex-start; align-items: flex-end;"/>
            <ui:Button text="2L" name="Menu2LeftButton" tabindex="0" triple-click-selects-line="false" style="position: absolute; top: auto; left: auto; bottom: auto; right: auto; width: 15%; height: 55%; aspect-ratio: auto; -unity-text-align: middle-center; align-self: flex-start; align-items: flex-start;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
