            <ui:Button text="Or create a new save" parse-escape-sequences="true" name="CreateNewSave" class="PauseMenuButtonsUSS" style="margin-top: 1%; margin-bottom: 1%; width: 116%; flex-grow: 0; height: auto; aspect-ratio: 8; -unity-font-definition: resource(&quot;Font/Barlow_Condensed/BarlowCondensed-SemiBold&quot;);"/>
