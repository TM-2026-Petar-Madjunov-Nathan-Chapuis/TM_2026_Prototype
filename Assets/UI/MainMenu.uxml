                    <ui:VisualElement name="Background" style="flex-grow: 1; position: absolute; width: 70%; height: 80%; left: 30%; background-color: rgba(46, 46, 46, 0.5); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 0.5px; border-right-width: 0; border-bottom-width: 0.5px; border-left-width: 0;">
                        <ui:VisualElement name="Separator" style="flex-grow: 1; width: 65%; height: auto; aspect-ratio: 100; position: absolute; left: 15%; top: 40%; background-color: rgb(255, 255, 255);"/>
                        <ui:Label text="Save 1" name="SaveName" class="SaveFileName" style="height: 60%; align-self: center; position: absolute; aspect-ratio: auto; -unity-text-align: middle-left; white-space: nowrap; text-overflow: ellipsis; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; align-content: center; justify-content: center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 255, 255); font-size: 40px; width: 65%; left: 15%; top: auto; bottom: 0%;"/>
                        <ui:Button text="" name="RenameButton" class="RenameButton" style="align-self: flex-end; width: auto; position: absolute; height: 30%; top: 10%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 12px; padding-bottom: 10px; padding-left: 12px; background-color: rgba(46, 46, 46, 0); right: 2%;"/>
                        <ui:Button text="" name="DeleteButton" class="DeleteButton" style="height: 30%; width: auto; align-self: flex-end; bottom: 10%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 12px; padding-bottom: 10px; padding-left: 12px; position: absolute; background-color: rgba(46, 46, 46, 0); right: 2%;"/>
                        <ui:Label text="01 / 01 / 2026   -   01h 00" name="SaveDate" double-click-selects-word="false" parse-escape-sequences="true" class="SaveFileName" style="height: 40%; align-self: center; position: absolute; aspect-ratio: auto; -unity-text-align: middle-left; white-space: nowrap; text-overflow: ellipsis; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; align-content: center; justify-content: center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 255, 255); font-size: 20px; width: 65%; left: 15%; top: 0%;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="SaveImage" style="flex-grow: 1; width: auto; height: 100%; aspect-ratio: 1.777778; align-self: flex-start; position: absolute; background-image: url(&quot;project://database/Assets/Textures/B%C3%BBche%20trop%20belle.png?fileID=2800000&amp;guid=0f310bc21bfaec14e9ea854a31d54ba8&amp;type=3#Bûche trop belle&quot;); background-color: rgb(46, 46, 46); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;">
                        <ui:VisualElement name="SaveImageLeftBottomBorder" style="flex-grow: 1; width: 50%; height: 50%; aspect-ratio: auto; align-self: flex-start; position: absolute; background-color: rgba(46, 46, 46, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 4px; border-left-width: 4px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 20px; top: auto; left: 0; bottom: 0%;"/>
                        <ui:VisualElement name="SaveImageTopRightBorder" style="flex-grow: 1; width: 50%; height: 50%; aspect-ratio: auto; align-self: flex-start; position: absolute; background-color: rgba(46, 46, 46, 0); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 0; border-top-right-radius: 20px; border-bottom-right-radius: 0; border-bottom-left-radius: 0; top: 0%; left: auto; bottom: auto; right: 0%;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="SaveFileTemp" class="SaveFileTemplate" style="height: auto; width: 100%; aspect-ratio: 5; margin-right: 0%; margin-left: 0%; margin-top: 1%; margin-bottom: 1%; background-color: rgba(46, 46, 46, 0); align-content: auto; align-self: center; justify-content: center; align-items: center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; translate: 0% 0; position: relative;">
                    <ui:VisualElement name="Background" style="flex-grow: 1; position: absolute; width: 70%; height: 80%; left: 30%; background-color: rgba(46, 46, 46, 0.5); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 0.5px; border-right-width: 0; border-bottom-width: 0.5px; border-left-width: 0;">
                        <ui:VisualElement name="Separator" style="flex-grow: 1; width: 65%; height: auto; aspect-ratio: 100; position: absolute; left: 15%; top: 40%; background-color: rgb(255, 255, 255);"/>
                        <ui:Label text="Save 2" name="SaveName" class="SaveFileName" style="height: 60%; align-self: center; position: absolute; aspect-ratio: auto; -unity-text-align: middle-left; white-space: nowrap; text-overflow: ellipsis; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; align-content: center; justify-content: center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 255, 255); font-size: 40px; width: 65%; left: 15%; top: auto; bottom: 0%;"/>
                        <ui:Button text="" name="RenameButton" class="RenameButton" style="align-self: flex-end; width: auto; position: absolute; height: 30%; top: 10%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 12px; padding-bottom: 10px; padding-left: 12px; background-color: rgba(46, 46, 46, 0); right: 2%;"/>
                        <ui:Button text="" name="DeleteButton" class="DeleteButton" style="height: 30%; width: auto; align-self: flex-end; bottom: 10%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 12px; padding-bottom: 10px; padding-left: 12px; position: absolute; background-color: rgba(46, 46, 46, 0); right: 2%;"/>
                        <ui:Label text="03 / 11 / 2025   -   02h 30" name="SaveDate" double-click-selects-word="false" parse-escape-sequences="true" class="SaveFileName" style="height: 40%; align-self: center; position: absolute; aspect-ratio: auto; -unity-text-align: middle-left; white-space: nowrap; text-overflow: ellipsis; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; align-content: center; justify-content: center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 255, 255); font-size: 20px; width: 65%; left: 15%; top: 0%;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="SaveImage" style="flex-grow: 1; width: auto; height: 100%; aspect-ratio: 1.777778; align-self: flex-start; position: absolute; background-image: url(&quot;project://database/Assets/Captures/camera_capture.png?fileID=2800000&amp;guid=18032f6cce275c64593c45a2ae260f97&amp;type=3#camera_capture&quot;); background-color: rgb(46, 46, 46); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; -unity-background-image-tint-color: rgb(255, 255, 255);">
                        <ui:VisualElement name="SaveImageLeftBottomBorder" style="flex-grow: 1; width: 50%; height: 50%; aspect-ratio: auto; align-self: flex-start; position: absolute; background-color: rgba(46, 46, 46, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 4px; border-left-width: 4px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 20px; top: auto; left: 0; bottom: 0%;"/>
                        <ui:VisualElement name="SaveImageTopRightBorder" style="flex-grow: 1; width: 50%; height: 50%; aspect-ratio: auto; align-self: flex-start; position: absolute; background-color: rgba(46, 46, 46, 0); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 0; border-top-right-radius: 20px; border-bottom-right-radius: 0; border-bottom-left-radius: 0; top: 0%; left: auto; bottom: auto; right: 0%;"/>
