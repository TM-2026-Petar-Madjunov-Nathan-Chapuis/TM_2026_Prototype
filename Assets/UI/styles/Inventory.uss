.inventory {
    flex-grow: 1;
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
}

.inventory__equipement {
    background-color: #0d00ff;
    flex-shrink: 0;
    width: 25%;
}

.inventory__item-description {
    background-color: #00ff0d;
    flex-shrink: 0;
    width: 25%;
}

.inventory__items-list {
    flex-grow: 1;
}

.inventory__weight-bar {
    align-self: stretch;
    flex-grow: 0;
    height: 40px;
}
.inventory__main {
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.inventory__items-label {
    -unity-text-align: middle-center;
}
.inventory__item-layout {
    position: absolute;
}
.inventory__grid-background {
    position: absolute;
    border-color: black;
    border-bottom-width: 1px;
    border-left-width: 1px;
}
.inventory__slot {
    border-color: black;
    border-width: 1px;
    border-left-width: 0px;
    border-bottom-width: 0px;
}